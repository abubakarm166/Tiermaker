# TierMaker Backend - copy to .env and adjust

# Required in production
SECRET_KEY=your-secret-key-at-least-50-chars

# Debug (set False in production)
DEBUG=True

# Comma-separated allowed hosts (include your EC2 public IP and domain in production)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — if set, Django uses Postgres instead of db.sqlite3 (see docs/POSTGRESQL_SETUP.md)
# DATABASE_URL=postgres://tiermaker_user:your_password@localhost:5432/tiermaker

# Optional: CORS origins when DEBUG=False (comma-separated)
# CORS_ORIGINS=https://yourfrontend.com

# JWT (optional overrides in code)
# ACCESS_TOKEN_LIFETIME=60
# REFRESH_TOKEN_LIFETIME=10080

# Password reset email links (your Next.js site)
FRONTEND_URL=http://localhost:3000

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=miadon722@gmail.com
EMAIL_HOST_PASSWORD="qrvz wuce fjej clzv"
DEFAULT_FROM_EMAIL=you@gmail.com

# X (Twitter) OAuth 2.0 — see docs/TWITTER_OAUTH_SETUP.md
# TWITTER_CLIENT_ID=your_oauth2_client_id
# TWITTER_CLIENT_SECRET=your_oauth2_client_secret
# Must match X Developer Portal exactly (trailing slash included):
# TWITTER_CALLBACK_URL=http://localhost:3000/api/auth/twitter/callback/
# TWITTER_OAUTH_SCOPES=users.read tweet.read offline.access

